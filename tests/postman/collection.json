        {
          "name": "Santé du service",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{backend_url}}/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Service et base UP\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(\"UP\");",
                  "  pm.expect(b.database).to.eql(\"UP\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "v1 - Liste paginée (page 2, size 5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{backend_url}}/api/v1/structures?page=2&size=5",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Réponse paginée cohérente\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.include.all.keys(\"page\", \"size\", \"total\", \"pages\", \"items\");",
                  "  pm.expect(b.items.length).to.be.at.most(b.size);",
                  "  pm.expect(b.pages).to.eql(Math.ceil(b.total / b.size));",
                  "});",
                  "",
                  "pm.test(\"Page 2 de 5 éléments sur 40\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.page).to.eql(2);",
                  "  pm.expect(b.items).to.have.length(5);",
                  "  pm.expect(b.total).to.eql(40);",
                  "  pm.expect(b.items[0].id).to.eql(6);",
                  "});"
                ]
              }
            }
          ]
