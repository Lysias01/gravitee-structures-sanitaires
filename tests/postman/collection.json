    {
      "name": "2. Gateway Gravitee - accès et quota",
      "item": [
        {
          "name": "Sans clé d'API -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_v1}}/structures",
            "description": "Le plan API Key exige l'en-tête X-Gravitee-Api-Key."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Clé d'API inventée -> 401",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Gravitee-Api-Key",
                "value": "cle-inventee-123"
              }
            ],
            "url": "{{gateway_v1}}/structures",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bout en bout - Clé valide -> 200 et données de la base",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Gravitee-Api-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{gateway_v1}}/structures/1",
            "description": "Chaîne complète : application souscrite -> gateway Gravitee -> FastAPI -> PostgreSQL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"La gateway renvoie la ligne insérée par 02_seed.sql\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.code).to.eql(\"CHU-CEN-001\");",
                  "  pm.expect(b.nom).to.eql(\"CHU Fictif de Ouagadougou Nord\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Recherche paginée via la gateway",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Gravitee-Api-Key",
                "value": "{{api_key}}"
              }
            ],
