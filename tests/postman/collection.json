    {
      "name": "4. Cycle de vie (manuel)",
      "item": [
        {
          "name": "Après UNPUBLISH : l'API répond toujours (200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Gravitee-Api-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{gateway_v1}}/structures/1",
            "description": "À lancer quand l'API est retirée du portail (UNPUBLISHED) mais toujours démarrée."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Après STOP : la gateway ne route plus",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Gravitee-Api-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{gateway_v1}}/structures/1",
            "description": "À lancer quand l'API est arrêtée (Stop the API)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Plus de routage vers le backend\", () => pm.expect(pm.response.code).to.be.oneOf([404, 503]));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
