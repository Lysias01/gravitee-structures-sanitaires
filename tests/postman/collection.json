            "method": "GET",
            "header": [
              {
                "key": "X-Gravitee-Api-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{gateway_v1}}/structures/999",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Format d'erreur standard\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.all.keys(\"status\", \"code\", \"message\", \"details\");",
                  "  pm.expect(b.status).to.eql(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Quota - rafale de 6 appels -> 429",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Gravitee-Api-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": "{{gateway_v1}}/structures",
            "description": "Attendre 10 secondes avant de relancer la collection."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Envoie 6 appels supplémentaires en rafale : la politique Rate Limit (5 req / 10 s) doit répondre 429.",
                  "const codes = [];",
                  "const call = (n) => {",
                  "  if (n === 0) {",
                  "    pm.test(\"Au moins une réponse 429 (quota dépassé)\", () => pm.expect(codes).to.include(429));",
                  "    console.log(\"Codes obtenus :\", codes.join(\", \"));",
                  "    return;",
                  "  }",
                  "  pm.sendRequest({url: pm.variables.replaceIn(\"{{gateway_v1}}/structures\"), method: \"GET\",",
                  "                  header: {\"X-Gravitee-Api-Key\": pm.variables.get(\"api_key\")}}, (err, res) => {",
                  "    codes.push(res ? res.code : 0);",
                  "    call(n - 1);",
                  "  });",
                  "};",
                  "call(6);"
                ]
              }
            }
          ]
        }
      ]
